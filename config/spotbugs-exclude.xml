<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions — baseline decisions recorded in docs/adr/ADR-001 (2026-07-16).

     EI_EXPOSE_REP / EI_EXPOSE_REP2 flag every constructor-injected Spring bean stored in a
     field and every getter returning a JPA entity/collection (122 of the 172 baseline
     findings). That is the intended architecture, not a defect, so the patterns are
     excluded wholesale rather than annotated at ~120 sites. -->
<FindBugsFilter>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- CT_CONSTRUCTOR_THROW guards against finalizer attacks — a JVM-security concern
         irrelevant to a desktop farm app; validating constructors that throw are the
         codebase's intended design (e.g. Item invariants). -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- DM_EXIT: System.exit is intentional in a Swing desktop app (login cancelled,
         CLI quit) — there is no container to hand control back to. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
    </Match>

    <!-- AT_STALE_THREAD_WRITE_OF_PRIMITIVE on DashboardTab.preparingDailySheet is a false positive.
         The flag is confined to the Swing event dispatch thread: it is read and written only by
         button action listeners, SwingWorker.done() (which Swing runs on that thread) and the
         helpers they call. The doInBackground() methods never touch it. SpotBugs cannot see EDT
         confinement, so this one field and pattern are excluded; any other stale-write finding
         still fails the gate. -->
    <Match>
        <Class name="com.flowerfarm.gui.tabs.DashboardTab"/>
        <Field name="preparingDailySheet"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
</FindBugsFilter>
