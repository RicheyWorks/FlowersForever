<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.flowerfarm</groupId>
    <artifactId>flowerfarm-manager</artifactId>
    <version>1.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Flower Farm Manager</name>
    <description>Spring Boot inventory manager for PNW flower farms (Port Orchard, Kitsap County).</description>

    <licenses>
        <license>
            <name>FlowersForever Proprietary License — All Rights Reserved</name>
            <url>LICENSE</url>
            <distribution>manual</distribution>
            <comments>No permission is granted except by written agreement with RicheyWorks.</comments>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flowerfarm.build.directory>target</flowerfarm.build.directory>
        <!-- Security patch overrides until the next Spring Boot BOM line absorbs them. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <!-- Tomcat security fixes: 10.1.58 was not released; 10.1.59 includes them. -->
        <tomcat.version>10.1.59</tomcat.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web (REST API + embedded Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Optional HTTP Basic auth for shared barn PCs (profile: auth) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (health, metrics) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JPA + file-based H2 for local inventory persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Optional SQLite dialect (activate with spring.profiles.active=sqlite) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- OpenPDF for weekly harvest + sales reports -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.39</version>
        </dependency>

        <!-- Standards-based QR payloads for printable harvest-lot traceability labels -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Excel / XLSX support -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- JFreeChart — dashboard charts (pie / bar) -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>1.5.6</version>
        </dependency>

        <!-- FlatLaf — modern Swing look &amp; feel + dark mode -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.2</version>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${flowerfarm.build.directory}</directory>
        <!-- Tests live flat in src/test (package-declared), not the Maven-default src/test/java -->
        <testSourceDirectory>src/test</testSourceDirectory>

        <plugins>
            <!-- Spring Boot executable fat JAR + headless=false for Swing GUI -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Djava.awt.headless=false</jvmArguments>
                </configuration>
            </plugin>

            <!-- Include *IT slice tests (WebMvcTest) that Surefire would otherwise skip -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Exercise the repackaged JAR after package, including its Boot loader. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/McpPackagedProcessSmokeIT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <flowerfarm.mcp.executable-jar>${project.build.directory}/${project.build.finalName}.jar</flowerfarm.mcp.executable-jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo — report plus meaningful line/branch regression floors (ADR-001) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.55</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- CycloneDX — SBOM (target/bom.json / bom.xml) for supply-chain visibility -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <configuration>
                    <schemaVersion>1.6</schemaVersion>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <outputName>bom</outputName>
                    <outputFormat>all</outputFormat>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <skipAttach>true</skipAttach>
                </configuration>
                <executions>
                    <execution>
                        <id>release-sbom</id>
                        <phase>package</phase>
                        <goals><goal>makeAggregateBom</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Generate bundled third-party notices and block strong-copyleft dependencies. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <executions>
                    <execution>
                        <id>third-party-license-policy</id>
                        <phase>generate-resources</phase>
                        <goals><goal>add-third-party</goal></goals>
                        <configuration>
                            <excludedScopes>test,provided</excludedScopes>
                            <failOnBlacklist>true</failOnBlacklist>
                            <excludedLicenses>
                                <excludedLicense>GNU General Public License 3</excludedLicense>
                                <excludedLicense>GNU General Public License v3.0</excludedLicense>
                                <excludedLicense>GNU Affero General Public License</excludedLicense>
                                <excludedLicense>GNU Affero General Public License v3.0</excludedLicense>
                            </excludedLicenses>
                            <force>true</force>
                            <generateBundle>true</generateBundle>
                            <bundleThirdPartyPath>META-INF/FlowersForever-THIRD-PARTY.txt</bundleThirdPartyPath>
                            <outputDirectory>${project.build.directory}/generated-resources/licenses</outputDirectory>
                            <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Defense in depth for the GPL analytics dependency removed in 1.1.0. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>ban-incompatible-distribution-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>nz.ac.waikato.cms.weka:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>Weka is GPLv3 and may not be bundled in the proprietary FlowersForever distribution.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Static analysis: zero-baseline SpotBugs and project-style Checkstyle gates. -->
        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.8.6.6</version>
                        <configuration>
                            <failOnError>true</failOnError>
                            <effort>Max</effort>
                            <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                            <xmlOutput>true</xmlOutput>
                        </configuration>
                        <executions>
                            <!-- Report everything Medium+ (visibility, non-blocking) -->
                            <execution>
                                <id>spotbugs-report</id>
                                <phase>verify</phase>
                                <goals><goal>spotbugs</goal></goals>
                                <configuration>
                                    <threshold>Medium</threshold>
                                </configuration>
                            </execution>
                            <!-- Ratchet: fail on any Medium+ finding (baseline fixed at 0, ADR-001) -->
                            <execution>
                                <id>spotbugs-gate</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                                <configuration>
                                    <threshold>Medium</threshold>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <configLocation>config/checkstyle.xml</configLocation>
                            <failsOnError>true</failsOnError>
                            <failOnViolation>true</failOnViolation>
                            <outputFileFormat>xml</outputFileFormat>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Native pointer/keyboard smoke. This profile intentionally replaces
          the normal Surefire includes so an operator opts into screen control
          without also running hundreds of headless tests behind the window.
        -->
        <profile>
            <id>installed-desktop-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/InstalledDesktopSmoke.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <flowerfarm.installed-desktop-smoke>true</flowerfarm.installed-desktop-smoke>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
